#!/usr/bin/env python3
"""gh merge-list: view and merge PRs from the Zephyr merge list (merge_list.json)

Subcommands:
  list   [--target T] [--status ready|waiting|blocked|all] [--mine] [--json]
  show   NUMBER...
  merge  [NUMBER...] [--target T] [--all] [--yes] [--dry-run] [--method M]
  pick   [--target T]        interactive picker, then merge the selection

Only "ready" PRs (all merge gates green) are offered for merging.  Before
merging, each PR is re-checked live on GitHub and skipped if it is no longer
open, has merge conflicts, has changes requested by a reviewer, or has failing
or pending CI.
"""

import argparse
import json
import os
import shutil
import subprocess
import sys
import urllib.request
from concurrent.futures import ThreadPoolExecutor

URL = "https://merge-list.zephyrproject.io/merge_list.json"
REPO = "zephyrproject-rtos/zephyr"
STATUS_ORDER = {"ready": 0, "waiting": 1, "blocked": 2}


# --------------------------------------------------------------------------
# merge-list feed
# --------------------------------------------------------------------------
def load_doc(url=URL):
    req = urllib.request.Request(url, headers={"User-Agent": "gh-merge-list"})
    with urllib.request.urlopen(req, timeout=60) as r:
        doc = json.load(r)
    if not isinstance(doc, dict) or "pull_requests" not in doc:
        sys.exit("error: unexpected merge list format")
    for p in doc["pull_requests"]:
        p.setdefault("target", p.get("base"))          # older name used by callers
        p.setdefault("labels", [])
        p["head_sha"] = (p.get("head") or {}).get("sha")
    doc["pull_requests"].sort(key=lambda p: (STATUS_ORDER.get(p["status"], 9),
                                             p["target"] or "", p["number"]))
    return doc


def load_prs(url=URL):
    return load_doc(url)["pull_requests"]


# --------------------------------------------------------------------------
# display helpers
# --------------------------------------------------------------------------
COLOR = sys.stdout.isatty() and os.environ.get("NO_COLOR") is None


def c(code, s):
    return f"\033[{code}m{s}\033[0m" if COLOR else s


STATUS_STYLE = {"ready": "32", "waiting": "33", "blocked": "31", "unknown": "2"}
GATE_GLYPH = {"pass": c("32", "●"), "wait": c("33", "◐"), "fail": c("31", "○"), None: "?"}


def gate_str(p):
    g = p.get("gates", {})
    return "".join(GATE_GLYPH.get(g.get(k)) for k in ("conflict", "ci", "approval", "review_time"))


def term_width():
    return shutil.get_terminal_size((120, 24)).columns


def print_table(prs, doc=None):
    if doc and doc.get("freeze_mode"):
        print(c("33", "merge list is in FREEZE MODE: only hotfix PRs are ready"))
    if not prs:
        print("no pull requests match")
        return
    w = term_width()
    tw = max(20, w - 7 - 9 - 5 - 14 - 16 - 8)
    print(c("1", f"{'PR':>7}  {'STATUS':<8} {'GATES':<4} {'TARGET':<13} {'AUTHOR':<15} TITLE"))
    for p in prs:
        title = p["title"]
        if p["labels"]:
            title += " " + " ".join(c("36", f"[{l}]") for l in p["labels"])
        if len(p["title"]) > tw:
            title = p["title"][:tw - 1] + "…"
        print(f"{p['number']:>7}  {c(STATUS_STYLE.get(p['status'], '0'), f'{p['status']:<8}')} "
              f"{gate_str(p)} {p['target']:<13} {p['author'][:15]:<15} {title}")
    counts = {}
    for p in prs:
        counts[p["status"]] = counts.get(p["status"], 0) + 1
    print(c("2", f"\n{len(prs)} PRs: " + ", ".join(f"{v} {k}" for k, v in counts.items())
            + "   gates: conflict-free / CI / assignee approval / review time"))


def print_detail(p):
    print(c("1", f"#{p['number']} {p['title']}"))
    print(f"  {p['url']}")
    print(f"  status:    {c(STATUS_STYLE.get(p['status'], '0'), p['status'])}  {gate_str(p)}")
    print(f"  target:    {p['target']}   milestone: {p['milestone'] or '-'}")
    print(f"  author:    {p['author']}")
    print(f"  assignees: {', '.join(p['assignees']) or '-'}")
    print(f"  approvers: {', '.join(p['approvers']) or '-'}")
    if p.get("ci_state"):
        print(f"  ci:        {p['ci_state']}")
    if p["labels"]:
        print(f"  labels:    {', '.join(p['labels'])}")
    if p.get("head_sha"):
        h = p["head"]
        print(f"  head:      {h.get('repo', '')}:{h.get('ref', '')} @ {p['head_sha'][:12]}")
    if p.get("changed_files") is not None:
        print(f"  size:      {p.get('commits', '?')} commits, {p.get('changed_files')} files, "
              f"+{p.get('additions', 0)}/-{p.get('deletions', 0)}")
    if p.get("hotfix"):
        print(f"  hotfix:    yes")


def gh_login():
    r = subprocess.run(["gh", "api", "user", "-q", ".login"], capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else None


def select(prs, target=None, status=None, mine=False, numbers=None):
    out = prs
    if target:
        out = [p for p in out if p["target"] == target]
    if status and status != "all":
        out = [p for p in out if p["status"] == status]
    if mine:
        me = gh_login()
        if not me:
            sys.exit("error: cannot determine GitHub login (gh auth status?)")
        out = [p for p in out if me in p["assignees"]]
    if numbers:
        want = set(numbers)
        out = [p for p in out if p["number"] in want]
        missing = want - {p["number"] for p in out}
        if missing:
            print(c("33", "warning: not on merge list: "
                    + ", ".join(f"#{n}" for n in sorted(missing))), file=sys.stderr)
    return out


# --------------------------------------------------------------------------
# merging
# --------------------------------------------------------------------------
# check conclusions / legacy status-context states that mean CI is not green
CHECK_FAILED = {"FAILURE", "CANCELLED", "TIMED_OUT", "ACTION_REQUIRED", "STARTUP_FAILURE",
                "ERROR"}
CHECK_IGNORED = {"SUCCESS", "SKIPPED", "NEUTRAL"}


def feed_problems(p):
    """Reasons from the merge-list feed itself why a PR must not be merged."""
    out = []
    if p["status"] != "ready":
        out.append(p["status"])
    if p.get("gates", {}).get("conflict") == "fail" or p.get("mergeable_state") == "dirty":
        out.append("merge conflicts")
    if p.get("gates", {}).get("ci") == "fail" or p.get("ci_state") not in (None, "SUCCESS"):
        out.append(f"CI {p.get('ci_state') or 'failing'}")
    return out


def live_problems(number):
    """Re-check a PR on GitHub; return reasons it must not be merged (empty = ok)."""
    fields = "state,isDraft,mergeable,mergeStateStatus,reviewDecision,statusCheckRollup"
    r = subprocess.run(["gh", "pr", "view", str(number), "--repo", REPO, "--json", fields],
                       capture_output=True, text=True)
    if r.returncode:
        return [f"gh pr view failed: {r.stderr.strip() or r.returncode}"]
    v = json.loads(r.stdout)
    out = []
    if v.get("state") != "OPEN":
        out.append(v.get("state", "?").lower())
    if v.get("isDraft"):
        out.append("draft")
    if v.get("mergeable") == "CONFLICTING" or v.get("mergeStateStatus") == "DIRTY":
        out.append("merge conflicts")
    if v.get("reviewDecision") == "CHANGES_REQUESTED":
        out.append("changes requested")
    # the rollup keeps superseded runs (e.g. a cancelled run re-triggered by a
    # push), so only the most recent run of each check counts
    latest = {}
    for chk in v.get("statusCheckRollup") or []:
        name = chk.get("name") or chk.get("context") or "?"
        started = chk.get("startedAt") or chk.get("createdAt") or ""
        if name not in latest or started >= latest[name][0]:
            latest[name] = (started, chk.get("conclusion") or chk.get("state"))
    failed = sorted(n for n, (_, verdict) in latest.items() if verdict in CHECK_FAILED)
    pending = [n for n, (_, verdict) in latest.items()
               if verdict not in CHECK_FAILED and verdict not in CHECK_IGNORED]
    if failed:
        out.append(f"CI failed ({', '.join(failed[:3])})")
    if pending:
        out.append(f"CI pending ({len(pending)})")
    return out


def check_mergeable(prs):
    """Drop PRs that are not mergeable according to the feed and a live GitHub check."""
    blocked = {}
    for p in prs:
        why = feed_problems(p)
        if why:
            blocked[p["number"]] = why
    candidates = [p for p in prs if p["number"] not in blocked]
    if candidates:
        print(c("2", f"re-checking {len(candidates)} PR(s) on GitHub..."), file=sys.stderr)
        with ThreadPoolExecutor(max_workers=8) as ex:
            for p, why in zip(candidates, ex.map(live_problems, [p["number"] for p in candidates])):
                if why:
                    blocked[p["number"]] = why
    if blocked:
        print(c("31", "refusing to merge:"))
        for p in prs:
            if p["number"] in blocked:
                print(c("31", f"  #{p['number']:<7} {'; '.join(blocked[p['number']])}"))
    return [p for p in prs if p["number"] not in blocked]


def merge_prs(prs, method, yes, dry_run):
    prs = check_mergeable(prs)
    if not prs:
        sys.exit("nothing to merge")

    print(c("1", f"About to merge {len(prs)} PR(s) into {REPO} (--{method}):"))
    for p in prs:
        print(f"  #{p['number']:<7} [{p['target']}] {p['title']}")
    if dry_run:
        print("\n(dry run) would run:")
        for p in prs:
            print(f"  gh pr merge {p['number']} --repo {REPO} --{method}")
        return 0
    if not yes:
        ans = input("\nProceed? [y/N] ").strip().lower()
        if ans not in ("y", "yes"):
            print("aborted")
            return 1

    failed = []
    for p in prs:
        n = p["number"]
        print(f"\n{c('1', f'merging #{n}')} {p['title']}")
        r = subprocess.run(["gh", "pr", "merge", str(n), "--repo", REPO, f"--{method}"],
                           text=True)
        if r.returncode:
            failed.append(n)
            print(c("31", f"  #{n} failed (exit {r.returncode})"))
        else:
            print(c("32", f"  #{n} merged"))
    print(f"\n{len(prs) - len(failed)} merged, {len(failed)} failed"
          + (": " + ", ".join(f"#{n}" for n in failed) if failed else ""))
    return 1 if failed else 0


def pick(prs):
    """Interactive picker: fzf if available, else a numbered prompt."""
    if not prs:
        sys.exit("no ready PRs to pick from")
    if shutil.which("fzf"):
        lines = "\n".join(f"{p['number']:<7} [{p['target']}] {p['title']}" for p in prs)
        r = subprocess.run(["fzf", "--multi", "--prompt", "merge> ",
                            "--header", "TAB to select, ENTER to confirm"],
                           input=lines, capture_output=True, text=True)
        chosen = {int(l.split()[0]) for l in r.stdout.splitlines() if l.strip()}
    else:
        for i, p in enumerate(prs, 1):
            print(f"{i:>3}) #{p['number']:<7} [{p['target']}] {p['title']}")
        raw = input("\nselect (e.g. 1 3 5-7, or 'all'): ").strip()
        idx = set()
        if raw == "all":
            idx = set(range(1, len(prs) + 1))
        else:
            for tok in raw.replace(",", " ").split():
                if "-" in tok:
                    a, b = tok.split("-", 1)
                    idx.update(range(int(a), int(b) + 1))
                elif tok.isdigit():
                    idx.add(int(tok))
        chosen = {prs[i - 1]["number"] for i in idx if 1 <= i <= len(prs)}
    return [p for p in prs if p["number"] in chosen]


# --------------------------------------------------------------------------
def main():
    ap = argparse.ArgumentParser(prog="gh merge-list",
                                 description=__doc__.split("\n\n")[0],
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--url", default=URL, help=argparse.SUPPRESS)
    sub = ap.add_subparsers(dest="cmd")

    def common(sp, status_default):
        sp.add_argument("-t", "--target", help="only PRs targeting this branch")
        sp.add_argument("-s", "--status", default=status_default,
                        choices=["ready", "waiting", "blocked", "all"])
        sp.add_argument("--mine", action="store_true", help="only PRs assigned to me")

    sp = sub.add_parser("list", help="list PRs (default: ready)")
    common(sp, "ready")
    sp.add_argument("--json", action="store_true", help="emit JSON instead of a table")
    sp.add_argument("-w", "--web", action="store_true", help="open the merge list in a browser")

    sp = sub.add_parser("show", help="show details for PRs")
    sp.add_argument("numbers", nargs="+", type=int)

    sp = sub.add_parser("merge", help="merge ready PRs")
    common(sp, "ready")
    sp.add_argument("numbers", nargs="*", type=int, help="PR numbers (default: all ready matching filters with --all)")
    sp.add_argument("--all", action="store_true", help="merge every ready PR matching the filters")
    sp.add_argument("-y", "--yes", action="store_true", help="do not ask for confirmation")
    sp.add_argument("-n", "--dry-run", action="store_true")
    sp.add_argument("-m", "--method", default="rebase", choices=["rebase", "merge", "squash"])

    sp = sub.add_parser("pick", help="interactively choose ready PRs to merge")
    common(sp, "ready")
    sp.add_argument("-y", "--yes", action="store_true")
    sp.add_argument("-n", "--dry-run", action="store_true")
    sp.add_argument("-m", "--method", default="rebase", choices=["rebase", "merge", "squash"])

    args = ap.parse_args()
    cmd = args.cmd or "list"
    if cmd == "list" and getattr(args, "web", False):
        import webbrowser
        webbrowser.open("https://merge-list.zephyrproject.io/")
        return 0

    doc = load_doc(args.url)
    prs = doc["pull_requests"]

    if cmd == "list" or args.cmd is None:
        sel = select(prs, getattr(args, "target", None), getattr(args, "status", "ready"),
                     getattr(args, "mine", False))
        if getattr(args, "json", False):
            print(json.dumps(sel, indent=2))
        else:
            print_table(sel, doc)
        return 0

    if cmd == "show":
        sel = select(prs, numbers=args.numbers)
        for i, p in enumerate(sel):
            if i:
                print()
            print_detail(p)
        return 0 if sel else 1

    if cmd == "merge":
        if not args.numbers and not args.all:
            sys.exit("error: give PR numbers or --all (see also: gh merge-list pick)")
        sel = select(prs, args.target, "all" if args.numbers else "ready",
                     args.mine, args.numbers or None)
        return merge_prs(sel, args.method, args.yes, args.dry_run)

    if cmd == "pick":
        sel = pick(select(prs, args.target, "ready", args.mine))
        if not sel:
            print("nothing selected")
            return 1
        return merge_prs(sel, args.method, args.yes, args.dry_run)


if __name__ == "__main__":
    sys.exit(main())
